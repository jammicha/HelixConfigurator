# Helix Configurator environment template — copy to .env and fill in.
# .env itself is gitignored.

# --- Required ---
HELIX_ENDPOINT=https://your-tenant.onbmc.com
HELIX_API_KEY=TenantID::AccessKey::SecretKey
X_SOURCE=your-business-service-name
APP_URL=http://localhost:8080

# --- Optional ---
# Paste from your AIOps service URL: /aiops/#/entities/service/<KEY>?type=key
# (You can paste the full URL — the UI will extract just the key.)
BUSINESS_SERVICE_KEY=

# Set to require sign-in to the configurator UI. Leave blank for open access.
UI_AUTH_PASSWORD=

# --- Internal (do not change unless renaming containers) ---
TARGET_CONTAINER_NAME=helix-gateway
