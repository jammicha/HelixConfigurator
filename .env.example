# Copy to .env and fill in before launching (or complete Step 1 in the wizard).
#
# These five bare keys always MIRROR the active connection (see "Manage
# Connections" in README.md). The configurator rewrites them itself every
# time you add, edit, remove, or switch a connection, so a hand edit here
# only lasts until the next such change.
HELIX_ENDPOINT=https://your-tenant.onbmc.com
HELIX_API_KEY=TenantID::AccessKey::SecretKey
X_SOURCE=your-business-service-name
BUSINESS_SERVICE_KEY=
HELIX_EVENTS_ENDPOINT=

# Per-connection keys, one triple per configured connection:
#   HELIX_ENDPOINT_<SUF>=...
#   HELIX_API_KEY_<SUF>=...
#   X_SOURCE_<SUF>=...
# where <SUF> is the connection id, upper-cased with non-alphanumeric
# characters replaced by underscores (e.g. id "prod-eu" -> suffix PROD_EU).
# These are MANAGED by the configurator's Manage Connections page: do not
# hand-edit or hand-add them. They back the `otlphttp/bmchelix_<id>` exporter
# blocks in helix-otel-collector.yaml and are rewritten on every connection
# change; a manual edit will be overwritten the next time you touch a
# connection in the UI.
